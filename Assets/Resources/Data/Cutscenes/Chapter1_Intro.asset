  m_Name: Chapter1_Intro
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  cutsceneName: Chapter 1 Intro
  defaultBeatDuration: 3.35
  finalHoldSeconds: 1.25
  defaultTypewriterWordsPerSecond: 6
  beats:
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: Do you still have that archive from the academy world?
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 8c22891853fca0243974ac56e732677b, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: f1dbd1e8d4ac8ee49a01b5df5dc549d8, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Specify archive. We passed through seven thousand academic civilizations
      before departure.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: f5697acfbe76d6e46a961c70bac573be, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: f1dbd1e8d4ac8ee49a01b5df5dc549d8, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: The one with students carrying rifles and halos over their heads. Blue
      city sectors. Too many clubs. Too little supervision.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: cc05f3ad0c83dd34eb1e2723b0b06f89, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: f1dbd1e8d4ac8ee49a01b5df5dc549d8, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Confirmed. Local youths possessed luminous halo structures and disproportionate
      access to military hardware.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 401719e259b2210429da1983ae10d474, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: f1dbd1e8d4ac8ee49a01b5df5dc549d8, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Their command structure was statistically unsound. Also, several cafeterias
      were classified as strategic targets.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: d84438aeb5ffe2e41b0e208f28dc270d, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: f1dbd1e8d4ac8ee49a01b5df5dc549d8, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Anomalous resilience is not a governing principle I recommend adopting.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 0a0f2d69df56db049a0733a56eb15539, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: f1dbd1e8d4ac8ee49a01b5df5dc549d8, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: And still, they survived. Halos, guns, absurd optimism. That world
      should not have worked.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 7bfbdb30b8a049049a303b990f17eb5b, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: f1dbd1e8d4ac8ee49a01b5df5dc549d8, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Final approach remains stable. Surface horizon entering visual range.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 43ed1da6fb4e11346b19297447f453d7, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: 40d0780651965ee41b816af25d4472ef, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: You sound almost peaceful, Nexus.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 9eb75abafb105994fb4aa804e011df27, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: 40d0780651965ee41b816af25d4472ef, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Correction. I am reporting an absence of immediate catastrophic failure.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 57d20fccc774c4a46af12163ce144c15, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: 40d0780651965ee41b816af25d4472ef, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 2
    showDialogue: 0
    speaker: 
    dialogue: 
    useTypewriter: 0
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 0}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 8300000, guid: 40d0780651965ee41b816af25d4472ef, type: 3}
