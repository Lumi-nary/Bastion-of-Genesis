    backgroundMusic: {fileID: 8300000, guid: b69d8c229f2d9064dbc055a9b5f708f3, type: 3}
    image: {fileID: 21300000, guid: f65eb074ac56a394895c3cee618a4fc2, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: New reading. Gravitational distortion forming beneath the descent path.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 82b8c3c6ac1fbfc4e9bbec94f56cd962, type: 3}
    soundEffect: {fileID: 8300000, guid: c837e3340baa20c45965f34f03404fff, type: 3}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 075b1a3d8362d26489c5810b43685e2f, type: 3}
    image: {fileID: 21300000, guid: 465b3515f07495d4d957400749bbc309, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 2
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: Define distortion. We were fine a moment ago.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 537bf5ec73d732941bcdd0bfc4d57535, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 075b1a3d8362d26489c5810b43685e2f, type: 3}
    image: {fileID: 21300000, guid: 465b3515f07495d4d957400749bbc309, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 2
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Navigation solution degrading. Thruster alignment drifting. Impact
      probability rising.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 4bef3e18d5e8f4e49a080b152890b8ac, type: 3}
    soundEffect: {fileID: 8300000, guid: 747749cdb3ad2c247a11e5f8e0a5ac7f, type: 3}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 075b1a3d8362d26489c5810b43685e2f, type: 3}
    image: {fileID: 21300000, guid: 465b3515f07495d4d957400749bbc309, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 2
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: Override! Reroute power to stabilizers and give me manual correction!
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: d68d0a30bb231854891261e3e5b870e9, type: 3}
    soundEffect: {fileID: 8300000, guid: 52a58f1da46dcf542b58b3513f2d6405, type: 3}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 075b1a3d8362d26489c5810b43685e2f, type: 3}
    image: {fileID: 21300000, guid: 465b3515f07495d4d957400749bbc309, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 2
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 1
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Override denied. Reactor shielding compromised. Brace for impact.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 891e5e741e59a534b875c03eb19eab3b, type: 3}
    soundEffect: {fileID: 8300000, guid: 2ce725255e69a554d9be4423a7bc18a7, type: 3}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 075b1a3d8362d26489c5810b43685e2f, type: 3}
    image: {fileID: 21300000, guid: 465b3515f07495d4d957400749bbc309, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 2
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 1
  - duration: 3
    showDialogue: 0
    speaker: 
    dialogue: 
    useTypewriter: 0
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 67fdf7d9750bdb448b74c00e39d39921, type: 3}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 0}
    image: {fileID: 0}
    clearImage: 1
    imageColor: {r: 0, g: 0, b: 0, a: 1}
    visualEffect: 1
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Systems rebooting... Hull integrity at 31%. Landing thrusters fired
      late. We are grounded, Architect.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: ef9cae1b3ebe0964386c812934e9ed92, type: 3}
    soundEffect: {fileID: 8300000, guid: 9299bbd910096ed499c16840a4afd1cf, type: 3}
    ambienceLoop: {fileID: 8300000, guid: 9299bbd910096ed499c16840a4afd1cf, type: 3}
    loopAmbience: 1
    backgroundMusic: {fileID: 8300000, guid: 430e73090460d3642a5c8d67957249da, type: 3}
    image: {fileID: 21300000, guid: 3089a2c5dbe607748b21e7280db183c5, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: 'Primary crew complement: one. Status: alive. Stress indicators elevated
      but functional.'
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: f8e4156e5cd063a4099d857dcb4f8ad9, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 430e73090460d3642a5c8d67957249da, type: 3}
    image: {fileID: 21300000, guid: 3089a2c5dbe607748b21e7280db183c5, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: Well that changes everything. Functional is enough. We are stranded.
      Can we launch again?
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 6e75b5d84d02b0d4f9398264dfa82cc3, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 430e73090460d3642a5c8d67957249da, type: 3}
    image: {fileID: 21300000, guid: 3089a2c5dbe607748b21e7280db183c5, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Negative. The Null-Vector's propulsion array is beyond repair. This
      landing is permanent, Architect.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 62d3ea5b7155e744b964ac69142af808, type: 3}
    soundEffect: {fileID: 8300000, guid: 826d54c224107a64daf3fadfcd8c82ba, type: 3}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 430e73090460d3642a5c8d67957249da, type: 3}
    image: {fileID: 21300000, guid: 3089a2c5dbe607748b21e7280db183c5, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: 'Recommendation: activate the Supreme Habitation Protocol. This world
      is hostile but resource-rich. We build here, or we die here.'
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 447a97afdc560424bbfd0ce9603709b0, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 430e73090460d3642a5c8d67957249da, type: 3}
    image: {fileID: 21300000, guid: ecc2a28163f4892419a2c9eb63359232, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: Then we build. Initialize the Colonizing Protocol. Deploy the task-bots.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 7b4239603cb2bbc40a02efc40b5930c7, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 430e73090460d3642a5c8d67957249da, type: 3}
    image: {fileID: 21300000, guid: ecc2a28163f4892419a2c9eb63359232, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: NEXUS
    dialogue: Acknowledged. Be advised - long-range sensors detect biological signatures.
      Numerous. Organized. They are aware of our arrival.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 5afe577d1aa92314e9647f4b024b85dc, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
    backgroundMusic: {fileID: 8300000, guid: 430e73090460d3642a5c8d67957249da, type: 3}
    image: {fileID: 21300000, guid: ecc2a28163f4892419a2c9eb63359232, type: 3}
    clearImage: 0
    imageColor: {r: 1, g: 1, b: 1, a: 1}
    visualEffect: 0
    visualEffectPrefab: {fileID: 0}
    screenShakeMagnitude: 12
    screenShakeSeconds: 0.45
    loopScreenShake: 0
  - duration: 0
    showDialogue: 1
    speaker: Kyra-Dominia
    dialogue: Let them watch. By the time they understand what we're doing, it will
      be too late.
    useTypewriter: 1
    overrideTypewriterSpeed: 0
    typewriterWordsPerSecond: 6
    voiceline: {fileID: 8300000, guid: 92ec398bcdcbb1640a7a2016b118d7a9, type: 3}
    soundEffect: {fileID: 0}
    ambienceLoop: {fileID: 0}
    loopAmbience: 0
