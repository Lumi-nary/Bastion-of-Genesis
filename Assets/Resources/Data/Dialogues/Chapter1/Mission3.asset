  entries:
  - speakerName: Nexus
    portrait: {fileID: 4329407632164072968, guid: 768fe4dd8c6c4b24f99cb3ea39d88b98, type: 3}
    expression: {fileID: 0}
    dialogueText: Commander, manual labor is unsustainable at this scale. The Builder Factory can produce Robotic Swarm units from raw materials, which we can then specialize into Researchers.
    voiceClip: {fileID: 0}
  - speakerName: Kyra-Dominia
    portrait: {fileID: 4329407632164072968, guid: ec3af396638fb02499ed390d58ca0309, type: 3}
    expression: {fileID: 0}
    dialogueText: We need bodies on the ground, metal or otherwise. Get that production pipeline running.
    voiceClip: {fileID: 0}
