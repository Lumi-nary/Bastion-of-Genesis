  m_Script: {fileID: 11500000, guid: 922cbf48982aa4f4ba81c16e6a7c9123, type: 3}
  m_Name: Mission4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueName: Mission4
  pauseGame: 0
  entries:
  - speakerName: Nexus
    portrait: {fileID: 4329407632164072968, guid: 768fe4dd8c6c4b24f99cb3ea39d88b98, type: 3}
    expression: {fileID: 0}
    dialogueText: Preliminary scans reveal unknown mineral compounds and anomalous physics on this world. A Laboratory would allow us to analyze and exploit these properties.
    voiceClip: {fileID: 0}
  - speakerName: Kyra-Dominia
    portrait: {fileID: 4329407632164072968, guid: ec3af396638fb02499ed390d58ca0309, type: 3}
    expression: {fileID: 0}
    dialogueText: If this planet has secrets, I want them working for us. Construct a Laboratory and begin research immediately.
    voiceClip: {fileID: 0}
  - speakerName: Nexus
    portrait: {fileID: 4329407632164072968, guid: 768fe4dd8c6c4b24f99cb3ea39d88b98, type: 3}
    expression: {fileID: 0}
    dialogueText: Our current storage capacity is limited. I recommend researching Resource Warehouses, Energy Batteries, and Robot Bays to expand our reserves before we proceed further.
    voiceClip: {fileID: 0}
