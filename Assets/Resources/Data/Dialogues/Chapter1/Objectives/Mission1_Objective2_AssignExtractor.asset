  m_Script: {fileID: 11500000, guid: 922cbf48982aa4f4ba81c16e6a7c9123, type: 3}
  m_Name: Mission1_Objective2_AssignExtractor
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueName: Mission1 Objective 2 - Assign Extractor
  pauseGame: 0
  entries:
  - speakerName: Nexus
    portrait: {fileID: 4329407632164072968, guid: 768fe4dd8c6c4b24f99cb3ea39d88b98, type: 3}
    expression: {fileID: 3622792381989719942, guid: df58ce550d446d847ba3ac2c700cb826, type: 3}
    dialogueText: Kyra, the Iron Extractor requires an Extractor worker.
    voiceClip: {fileID: 0}
  - speakerName: Nexus
    portrait: {fileID: 4329407632164072968, guid: 768fe4dd8c6c4b24f99cb3ea39d88b98, type: 3}
    expression: {fileID: 3622792381989719942, guid: df58ce550d446d847ba3ac2c700cb826, type: 3}
    dialogueText: Without that worker, the building will not operate.
    voiceClip: {fileID: 0}
  - speakerName: Nexus
    portrait: {fileID: 4329407632164072968, guid: 768fe4dd8c6c4b24f99cb3ea39d88b98, type: 3}
    expression: {fileID: 3622792381989719942, guid: df58ce550d446d847ba3ac2c700cb826, type: 3}
    dialogueText: This applies to every building with worker requirements.
    voiceClip: {fileID: 0}
  - speakerName: Nexus
    portrait: {fileID: 4329407632164072968, guid: 768fe4dd8c6c4b24f99cb3ea39d88b98, type: 3}
    expression: {fileID: 3622792381989719942, guid: df58ce550d446d847ba3ac2c700cb826, type: 3}
    dialogueText: Open Worker Assignment and assign one Extractor.
    voiceClip: {fileID: 0}
